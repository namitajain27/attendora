# Leave DATABASE_URL empty to use a local SQLite file (easiest).
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/attendora
DATABASE_URL=

# Teacher login (change these!)
TEACHER_ID=TCH001
TEACHER_PASSWORD=admin123
TEACHER_NAME=Teacher

# Long random string used to sign login tokens
SECRET_KEY=change-this-to-a-long-random-string

# Face matching strictness: lower = stricter (0.4 - 0.6 is typical)
FACE_TOLERANCE=0.5
